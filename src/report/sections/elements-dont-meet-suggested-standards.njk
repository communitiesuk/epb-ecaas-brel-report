{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

<div class="brel-section">
  <h2 class="govuk-heading-l brel-section-heading">
    <span class="brel-section-heading__icon brel-section-heading__icon--warning" aria-hidden="true">!</span>
    Elements that don't meet suggested standards
  </h2>

  <p class="govuk-body-m">
    This highlights elements which don’t meet the suggested standards in Approved document L. This information can be used by building control to identify areas of weaker performance. Dwellings do not need to meet these standards to comply with Part L of the building regulations.
  </p>

  {% set rows = [] %}

  {% for item in elementsBelowStandards %}
    {% set row = [
      { text: item.element },
      { text: item.guidance },
      { text: item.inDwelling },
      { text: item.explanation }
    ] %}

    {% set rows = (rows.push(row), rows) %}
  {% endfor %}

  {% if rows.length %}
    {{ govukTable({
      head: [
        { text: "Element" },
        { text: "Guidance" },
        { text: "In this dwelling" },
        { text: "Explanation" }
      ],
      firstCellIsHeader: true,
      rows: rows
    }) }}
  {% else %}
    <p class="govuk-body">No elements found which require review.</p>
  {% endif %}
</div>